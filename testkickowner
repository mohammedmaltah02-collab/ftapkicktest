-- =========================
--  AUTO-KICK ENGINE (event-driven = FAST)
-- =========================
local activeConnections = {}

local function startAutoKick()
	local plot = getMyPlot()
	if not plot then
		Library:Notify({ Title = "Kick Ownership", Description = "No plot found — can't auto-kick.", Time = 3 })
		return
	end

	local originPart = plot:FindFirstChild("Spawn") or plot:FindFirstChild("Floor")
	if not originPart then
		-- fallback to plot's PrimaryPart or a random BasePart
		originPart = plot.PrimaryPart
		if not originPart then
			for _, d in ipairs(plot:GetDescendants()) do
				if d:IsA("BasePart") then
					originPart = d
					break
				end
			end
		end
	end
	if not originPart then return end

	-- Connection 1: check each player's HumanoidRootPart every Heartbeat
	table.insert(activeConnections, RunService.Heartbeat:Connect(function()
		if not Toggles.AutoKick.Value then return end
		local range = Options.KickRange.Value
		local origin = originPart.Position

		for _, player in ipairs(Players:GetPlayers()) do
			if player == LocalPlayer then continue end
			local char = player.Character
			if not char then continue end
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then continue end

			if (root.Position - origin).Magnitude <= range then
				kickPlayer(player)
			end
		end
	end))

	-- Connection 2: instant detection when a character spawns in range
	table.insert(activeConnections, Players.PlayerAdded:Connect(function(player)
		if not Toggles.AutoKick.Value then return end
		player.CharacterAdded:Connect(function(char)
			task.wait(0.1)
			local root = char:FindFirstChild("HumanoidRootPart")
			if root and (root.Position - originPart.Position).Magnitude <= Options.KickRange.Value then
				kickPlayer(player)
			end
		end)
	end))
end

local function stopAutoKick()
	for _, conn in ipairs(activeConnections) do
		pcall(function() conn:Disconnect() end)
	end
	activeConnections = {}
end

Toggles.AutoKick:OnChanged(function()
	if Toggles.AutoKick.Value then
		startAutoKick()
		Library:Notify({ Title = "Kick Ownership", Description = "Auto-kick ON", Time = 2 })
	else
		stopAutoKick()
		Library:Notify({ Title = "Kick Ownership", Description = "Auto-kick OFF", Time = 2 })
	end
end)

