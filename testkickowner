-- =========================
--  FIND REMOTES (auto-detect common FTAP names)
-- =========================
local kickRemote = nil

local function findRemote()
	-- Try common paths
	local paths = {
		{"Remotes", "Kick"},
		{"Remotes", "KickPlayer"},
		{"Remotes", "Ownership", "Kick"},
		{"Remotes", "Plot", "Kick"},
		{"RemoteEvents", "Kick"},
		{"Kick"},
	}

	for _, path in ipairs(paths) do
		local current = ReplicatedStorage
		local found = true
		for _, segment in ipairs(path) do
			current = current:FindFirstChild(segment)
			if not current then
				found = false
				break
			end
		end
		if found and current and current:IsA("RemoteEvent") then
			kickRemote = current
			return true
		end
	end
	return false
end

findRemote()

-- Fallback: scan ReplicatedStorage for anything with "kick" in the name
if not kickRemote then
	for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
		if obj:IsA("RemoteEvent") and string.find(string.lower(obj.Name), "kick") then
			kickRemote = obj
			break
		end
	end
end

-- =========================
--  GET OWN PLOT
-- =========================
local function getMyPlot()
	local plots = workspace:FindFirstChild("Plots") or workspace:FindFirstChild("Houses")
	if not plots then return nil end

	for _, plot in ipairs(plots:GetChildren()) do
		local owner = plot:FindFirstChild("Owner") or plot:GetAttribute("Owner")
		if typeof(owner) == "Instance" and owner.Value == LocalPlayer then
			return plot
		elseif typeof(owner) == "string" and owner == LocalPlayer.Name then
			return plot
		elseif plot:GetAttribute("Owner") == LocalPlayer.UserId then
			return plot
		end
	end

	-- fallback: try to find by character proximity
	local char = LocalPlayer.Character
	if not char then return nil end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return nil end

	local closest, dist = nil, math.huge
	for _, plot in ipairs(plots:GetChildren()) do
		local part = plot:FindFirstChild("Spawn") or plot:FindFirstChild("Floor")
		if part and part:IsA("BasePart") then
			local d = (part.Position - root.Position).Magnitude
			if d < dist then
				dist = d
				closest = plot
			end
		end
	end
	return closest
end

-- =========================
--  KICK FUNCTION (fires instantly)
-- =========================
local kickedRecently = {}

local function kickPlayer(target)
	if not target or target == LocalPlayer then return end
	if kickedRecently[target.UserId] then return end
	kickedRecently[target.UserId] = true

	-- method 1: remote
	if kickRemote then
		pcall(function()
			kickRemote:FireServer(target)
		end)
		pcall(function()
			kickRemote:FireServer(target.UserId)
		end)
		pcall(function()
			kickRemote:FireServer("Kick", target)
		end)
	end

	-- method 2: ownership attribute toggling (some FTAP versions)
	local plot = getMyPlot()
	if plot then
		local ownerRemote = plot:FindFirstChild("OwnerRemote") or plot:FindFirstChild("KickRemote")
		if ownerRemote then
			pcall(function()
				ownerRemote:FireServer(target)
			end)
		end
	end

	-- clear flag after 3s so we can re-kick if needed
	task.delay(3, function()
		kickedRecently[target.UserId] = nil
	end)
end

